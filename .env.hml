# Homologation (staging) environment variables.
# These are committed to source so the `admin-alertport-hml` Vercel project
# can mirror them. Real values live on the Vercel project's Environment
# Variables panel — this file is for documentation / local HML testing only.

# ───────────── API ─────────────
NEXT_PUBLIC_API_URL=https://api-hml.shieldgo.com.br

# ───────────── WebSocket / Chat (ms-chat) ─────────────
NEXT_PUBLIC_MS_CHAT_URL=https://ms-chat-shield-hml-c310ed4e6696.herokuapp.com

# ───────────── WebRTC ─────────────
NEXT_PUBLIC_WEBRTC_ICE_SERVERS=
NEXT_PUBLIC_WEBRTC_TURN_URLS=
NEXT_PUBLIC_WEBRTC_TURN_USERNAME=
NEXT_PUBLIC_WEBRTC_TURN_PASSWORD=

# ───────────── Firebase (HML) ─────────────
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAclLPx6m8m3gJuKtrbLhKrXsowbkUIb34
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=shieldgo-hml.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=shieldgo-hml
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=shieldgo-hml.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=396522245857
NEXT_PUBLIC_FIREBASE_APP_ID=1:396522245857:web:d41f74221e161cecc771a0
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-2B7PBKGSSM

# ───────────── App ─────────────
NEXT_PUBLIC_APP_MODE=development
NEXT_PUBLIC_IS_PRODUCTION=false
NEXT_PUBLIC_DEFAULT_LOCALE=pt
NEXT_PUBLIC_MASTER_ADMIN_EMAILS=

# ───────────── Observability ─────────────
# Sentry project: alerport-admin-web-hml (ID 4511260900524032)
# Events go through the same-origin `/monitoring` tunnel, so the DSN
# only needs to be valid for browser SDK boot - no CSP allow-list.
NEXT_PUBLIC_SENTRY_DSN=https://2e052708631cb4712e755c0f27b5120e@o4507014507986944.ingest.us.sentry.io/4511260900524032
# Environment tag attached to every Sentry event. Kept separate from
# NEXT_PUBLIC_APP_MODE so we can flip Sentry's HML/PROD surfaces
# without disturbing feature flags that also read APP_MODE.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=hml
# Selects the target project when the build uploads source maps.
SENTRY_ORG=grasp-jc
SENTRY_PROJECT=alerport-admin-web-hml
