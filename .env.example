# Copy to .env.local for development, or .env.production for production builds.
# Everything prefixed with NEXT_PUBLIC_* is exposed to the browser bundle.

# ───────────── API ─────────────
NEXT_PUBLIC_API_URL=https://api-hml.shieldgo.com.br

# ───────────── WebSocket / Chat (ms-chat) ─────────────
NEXT_PUBLIC_MS_CHAT_URL=https://ms-chat-shield-hml-c310ed4e6696.herokuapp.com

# ───────────── WebRTC ─────────────
# Full ICE servers config as JSON (takes precedence over TURN_* vars):
# NEXT_PUBLIC_WEBRTC_ICE_SERVERS=[{"urls":["turn:turn.example.com"],"username":"u","credential":"p"}]
NEXT_PUBLIC_WEBRTC_TURN_URLS=
NEXT_PUBLIC_WEBRTC_TURN_USERNAME=
NEXT_PUBLIC_WEBRTC_TURN_PASSWORD=

# ───────────── Firebase ─────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ───────────── App ─────────────
NEXT_PUBLIC_APP_MODE=development
NEXT_PUBLIC_IS_PRODUCTION=false
NEXT_PUBLIC_DEFAULT_LOCALE=pt
# Comma-separated emails allowed as SUPER_ADMIN_MASTER (empty = allow all admins)
NEXT_PUBLIC_MASTER_ADMIN_EMAILS=

# ───────────── Observability ─────────────
# Sentry DSN. Leave blank in local dev so errors don't ship to the
# shared Sentry project. Real values live in .env.hml and
# .env.production, and in each Vercel project's Environment
# Variables pane.
NEXT_PUBLIC_SENTRY_DSN=
# Sentry environment tag. Suggested values: `hml`, `production`.
# Falls back to NEXT_PUBLIC_APP_MODE when empty.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Org + project drive source-map upload at build time (only
# consulted when SENTRY_AUTH_TOKEN is set, otherwise the wrapper
# quietly skips the upload step).
SENTRY_ORG=
SENTRY_PROJECT=
# Personal / CI auth token generated in Sentry settings. Required
# *only* when you want `next build` to ship source maps for
# resolved stack traces. Keep it out of committed env files.
SENTRY_AUTH_TOKEN=
