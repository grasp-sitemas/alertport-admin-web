# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Only the .env.example template stays tracked. Real values for HML
# and PROD live in Vercel's Environment Variables pane - never commit
# them, even if they look "public" today (a future contributor may add
# a real secret next to NEXT_PUBLIC_* vars without noticing). Existing
# tracked .env.hml / .env.production files stay tracked until rotated;
# remove them with `git rm --cached` after migrating values to Vercel.
!.env.example
# !.env.hml          ← DO NOT re-enable. Use `vercel env pull` instead.
# !.env.production   ← DO NOT re-enable. Use `vercel env pull` instead.

# vercel
.vercel
.vercel.*.bak

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code — local/per-developer state (não commitar)
.claude/settings.local.json
.claude/agent-memory/last-typecheck.txt
CLAUDE.local.md
.worktreeinclude.log
.env*.local
