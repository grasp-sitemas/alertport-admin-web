# Production environment variables for alertport-admin-web
# Backend / gateway / chat / firebase configuration for PROD
#
# IMPORTANT: NEXT_PUBLIC_* vars are embedded in the client bundle.
# Do NOT put real secrets here (TURN passwords, private keys, etc.) —
# configure them per-deployment in your host's secret manager.

# ───────────── API ─────────────
NEXT_PUBLIC_API_URL=https://api-gateway-shield.herokuapp.com

# ───────────── WebSocket / Chat (ms-chat) ─────────────
NEXT_PUBLIC_MS_CHAT_URL=https://api-chat-hml.shieldgo.com.br

# ───────────── WebRTC ─────────────
# Production should use hosted TURN. Fill via host secret manager:
NEXT_PUBLIC_WEBRTC_ICE_SERVERS=
NEXT_PUBLIC_WEBRTC_TURN_URLS=
NEXT_PUBLIC_WEBRTC_TURN_USERNAME=
NEXT_PUBLIC_WEBRTC_TURN_PASSWORD=

# ───────────── Firebase (PRD) ─────────────
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAdcAjt9Cdjs4vh5BTxSXcWbT0uchMcM-A
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=shieldgo.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=shieldgo
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=shieldgo.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=569460808844
NEXT_PUBLIC_FIREBASE_APP_ID=1:569460808844:web:14156a28a547faf8926fa9
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-SJYL759PFQ

# ───────────── App ─────────────
NEXT_PUBLIC_APP_MODE=production
NEXT_PUBLIC_IS_PRODUCTION=true
NEXT_PUBLIC_DEFAULT_LOCALE=pt
NEXT_PUBLIC_MASTER_ADMIN_EMAILS=

# ───────────── Observability ─────────────
NEXT_PUBLIC_SENTRY_DSN=
