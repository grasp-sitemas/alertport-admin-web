{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Copie para .claude/settings.local.json (gitignored). Coloque aqui overrides por desenvolvedor — tokens de MCP, permissões experimentais, hooks em teste.",
  "permissions": {
    "allow": [
      "Bash(code:*)",
      "Bash(open:*)"
    ]
  },
  "mcpServers": {
    "github": {
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_seu_token_aqui" }
    },
    "sentry": {
      "env": { "SENTRY_AUTH_TOKEN": "seu_token_aqui" }
    }
  }
}
